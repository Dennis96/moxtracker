{
  "name": "moxtracker",
  "version": "0.1.0",
  "private": true,
  "description": "Il server che riceve le partite di Mox e il sito che le mostra",
  "type": "module",
  "scripts": {
    "prove": "node --test prove/*.test.js",
    "genera-archetipi": "python strumenti/genera_catalogo_archetipi.py",
    "diagnostica-archetipo": "node strumenti/diagnostica_archetipo.mjs",
    "locale": "wrangler dev --local",
    "sito-locale": "node strumenti/anteprima_sito.mjs",
    "database-locale": "wrangler d1 execute moxtracker --local --file=schema.sql",
    "database-draft-locale": "wrangler d1 execute moxtracker-draft-index --local --file=schema-draft.sql",
    "database-vero": "wrangler d1 execute moxtracker --remote --file=schema.sql",
    "pubblica": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
